    "url": "https://links.atanasiu.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doinel1a/next-ts-better-auth-trpc-drizzle"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "prepare": "husky",
    "postinstall": "playwright install",
    "dev": "next dev",
    "build": "next build",
    "preview": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:profiling": "cross-env TIMING=all eslint",
    "format": "prettier --write **/**/*.{html,css,scss,js,jsx,cjs,mjs,ts,tsx,mdx} --cache",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "ba:generate": "npx @better-auth/cli generate --config ./src/server/auth/index.ts",
    "db:studio": "drizzle-kit --config=drizzle/config.ts studio",
    "db:push": "drizzle-kit --config=drizzle/config.ts push",
    "db:create-migration": "drizzle-kit --config=drizzle/config.ts generate",
    "db:migrate": "drizzle-kit --config=drizzle/config.ts migrate",
    "db:seed": "cross-env SKIP_ENV_VALIDATION=true tsx drizzle/seeders/index.ts",
    "db-danger:reset": "cross-env SKIP_ENV_VALIDATION=true tsx drizzle/seeders/reset.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.103.0",
    "@tanstack/react-query-devtools": "5.103.0",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "superjson": "2.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.103.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "cssnano": "9.0.4",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-dom": "5.19.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.19.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "75.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sass": "1.104.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
